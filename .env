# Muestra de Backblaze Drive Stats que usan los servicios de docker-compose.yml.
# Antes de cada job se valida en data/raw y se descarga lo que falte.

# Trimestre del ZIP de Backblaze (Q1_2026, Q2_2026, …)
DS_QUARTER=Q2_2026
# Primer día (AAAA-MM-DD); vacío = primer día del trimestre
DS_START=
# Número de días consecutivos (el enunciado recomienda de 7 a 14)
DS_DAYS=7

# Parte C (streaming con Kafka)
# Segundos reales por cada día de datos (reloj acelerado del producer)
STREAM_SECONDS_PER_DAY=10
# Modelos separados por comas; vacío = los 5 por defecto (part_c/events.py); «all» = todos
STREAM_MODELS=
# Porcentaje de discos que se publican (muestreo por hash del serial)
STREAM_SAMPLE_PCT=100
# Porcentaje de discos cuyos eventos llegan tarde, y con cuántos días de retraso
STREAM_LATE_PCT=2
STREAM_LATE_DAYS=1

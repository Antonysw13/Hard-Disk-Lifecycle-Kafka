# Muestra de Backblaze Drive Stats que usan los servicios de docker-compose.yml.
# Antes de cada job se valida en data/raw y se descarga lo que falte.

# Trimestre del ZIP de Backblaze (Q1_2026, Q2_2026, …)
DS_QUARTER=Q2_2026
# Primer día (AAAA-MM-DD); vacío = primer día del trimestre
DS_START=
# Número de días consecutivos (el enunciado recomienda de 7 a 14)
DS_DAYS=7
